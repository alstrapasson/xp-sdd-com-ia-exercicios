    {
      "name": "1. Demo reabertura",
      "item": [
        {
          "name": "1. Abrir ordem (corretiva, EQ-1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipamento_id\": \"EQ-1\",\n  \"tipo\": \"corretiva\",\n  \"descricao\": \"Vazamento recorrente na vedação\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"ordemId\", o.id);",
                  "pm.collectionVariables.set(\"prazoOriginal\", o.prazo);",
                  "pm.test(\"status aberta, prazo e prioridade calculados\", () => { pm.expect(o.status).to.eql(\"aberta\"); pm.expect(o.prazo).to.be.a(\"string\"); pm.expect(o.prioridade).to.be.within(1, 5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Reabrir ordem ainda aberta -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/reabrir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "reabrir"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Concluir ordem",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"concluida\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"concluida_em preenchido\", () => pm.expect(pm.response.json().concluida_em).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Reabrir ordem concluída -> 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/reabrir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "reabrir"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test(\"volta para aberta\", () => pm.expect(o.status).to.eql(\"aberta\"));",
                  "pm.test(\"reaberturas = 1\", () => pm.expect(o.reaberturas).to.eql(1));",
                  "pm.test(\"concluida_em limpo\", () => pm.expect(o.concluida_em).to.be.null);",
                  "pm.test(\"prazo recalculado (maior que o original)\", () => pm.expect(new Date(o.prazo) > new Date(pm.collectionVariables.get(\"prazoOriginal\"))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Reabrir de novo (já está aberta) -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/reabrir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "reabrir"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Consultar ordem reaberta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"reaberturas persistido\", () => pm.expect(pm.response.json().reaberturas).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Ciclo 2: concluir e reabrir de novo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"concluida\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Segunda reabertura -> reaberturas = 2",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ordens/{{ordemId}}/reabrir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordens",
                "{{ordemId}}",
                "reabrir"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"reaberturas = 2\", () => pm.expect(pm.response.json().reaberturas).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
