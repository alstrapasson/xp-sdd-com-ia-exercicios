{
  "info": {
    "name": "API de Manutenção — Lab 01 (reabertura de ordem)",
    "description": "Rode a pasta '1. Demo reabertura' com o Collection Runner, na ordem. Requer a API em execução (uvicorn app.main:app --reload).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "ordemId",
      "value": ""
    },
    {
      "key": "prazoOriginal",
      "value": ""
    },
    {
      "key": "ordemCanceladaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Básicos",
      "item": [
        {
          "name": "Saúde",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saude",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saude"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
